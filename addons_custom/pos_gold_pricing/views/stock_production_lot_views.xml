
<odoo>
  <record id="view_stock_production_lot_form_gold" model="ir.ui.view">
    <field name="name">stock.lot.form.gold</field>
    <field name="model">stock.lot</field>
    <field name="inherit_id" ref="stock.view_production_lot_form"/>
    <field name="arch" type="xml">
      <form position="attributes">
        <attribute name="string">Lot/Serial Number</attribute>
      </form>
      <xpath expr="//sheet/notebook" position="inside">
        <page string="Jewelry">
          <group>
            <field name="metal_type_id" context="{'default_company_id': company_id}" options="{'no_create_edit': False}"/>
            <field name="net_gold_weight"/>
            <field name="gross_weight"/>
            <field name="stone_weight_ct"/>
            <field name="wage_type"/>
            <field name="wage_value"/>
            <field name="process_technique"/>
            <field name="certificate_no"/>
          </group>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
