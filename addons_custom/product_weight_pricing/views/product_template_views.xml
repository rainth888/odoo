<odoo>
  <record id="product_template_form_pricing_method" model="ir.ui.view">
    <field name="name">product.template.form.pricing.method</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view"/>
    <field name="priority">99</field>
    <field name="arch" type="xml">
      <!-- Replace list_price block wrapper to enforce a strict two-row layout -->
      <xpath expr="//sheet//group//div[@name='list_price_uom'][1]" position="replace">
        <div name="list_price_uom">
          <!-- Row 1: Pricing method selector under the Sales Price label -->
          <div class="o_row">
            <field name="pos_pricing_method" class="oe_inline" nolabel="1"/>
          </div>
          
          <!-- Row 2 (By Unit): price + 'per' + unit of measure -->
          <div class="o_row" invisible="pos_pricing_method != 'by_unit'">
            <field name="list_price" nolabel="1" class="oe_inline"/>
            <span class="oe_inline"> per </span>
            <field name="uom_id" nolabel="1" class="oe_inline"/>
          </div>
          
          <!-- Row 2 (By Weight): weight_g + unit of measure (no 'per') -->
          <div class="o_row" invisible="pos_pricing_method != 'by_weight'">
            <field name="weight_g" nolabel="1" class="oe_inline"/>
            <span class="oe_inline"> </span>
            <field name="uom_id" nolabel="1" class="oe_inline"/>
          </div>
        </div>
      </xpath>

      <!-- Hide pricing-related rows when By Weight to ensure only two lines appear in this area -->
      <xpath expr="//sheet//group//field[@name='taxes_id']" position="attributes">
        <attribute name="invisible">pos_pricing_method == 'by_weight'</attribute>
      </xpath>
      <xpath expr="//sheet//group//field[@name='standard_price']" position="attributes">
        <attribute name="invisible">pos_pricing_method == 'by_weight'</attribute>
      </xpath>
      <xpath expr="//sheet//group//field[@name='supplier_taxes_id']" position="attributes">
        <attribute name="invisible">pos_pricing_method == 'by_weight'</attribute>
      </xpath>
    </field>
  </record>
</odoo>
