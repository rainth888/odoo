<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- 58mm 票据纸张格式 -->
  <record id="paperformat_58mm_receipt" model="report.paperformat">
    <field name="name">Receipt 58mm</field>
    <field name="default" eval="False"/>
    <field name="format">custom</field>
    <field name="page_width">58</field>       <!-- 单位：毫米 -->
    <field name="page_height">300</field>     <!-- 可调长，比如 300/600；热敏票据较长 -->
    <field name="orientation">Portrait</field>
    <field name="margin_top">2</field>
    <field name="margin_bottom">2</field>
    <field name="margin_left">2</field>
    <field name="margin_right">2</field>
    <field name="dpi">203</field>
    <field name="header_line" eval="False"/>
    <field name="header_spacing">0</field>
    <field name="disable_shrinking" eval="True"/>
  </record>

  <!-- ② 可选：80mm 纸张 -->
  <record id="paperformat_80mm_receipt" model="report.paperformat">
    <field name="name">Receipt 80mm</field>
    <field name="default" eval="False"/>
    <field name="format">custom</field>
    <field name="page_width">80</field>
    <field name="page_height">300</field>
    <field name="orientation">Portrait</field>
    <field name="margin_top">2</field>
    <field name="margin_bottom">2</field>
    <field name="margin_left">2</field>
    <field name="margin_right">2</field>
    <field name="dpi">203</field>
    <field name="header_line" eval="False"/>
    <field name="header_spacing">0</field>
    <field name="disable_shrinking" eval="True"/>
  </record>

  <!-- ③ QWeb 模板：支持多记录（docs）渲染，适配热敏宽度 -->
  <template id="report_sale_receipt_document">
    <t t-call="web.basic_layout">
      <t t-foreach="docs" t-as="doc">
        <t t-set="company" t-value="doc.company_id"/>
        <div class="page o_sale_receipt" t-attf-style="width:#{company.receipt_paper_width or '58'}mm; font-size:#{company.receipt_font_size or '10'}px;">
          <style>
            .o_sale_receipt { font-family: "Noto Sans CJK SC","DejaVu Sans",sans-serif; line-height:1.35; color:#000; padding:2mm; margin:0 auto; }
            .center { text-align:center; } .bold { font-weight:700; } .xs { font-size:8pt; } .muted { color:#333; }
            .line { border-top:1px dashed #000; margin:6px 0; } .mb4{margin-bottom:4px}
            table { width:100%; border-collapse:collapse; } th,td { padding:2px 0; vertical-align:top; }
            .r { text-align:right; } .l{ text-align:left; }
            .list-row { display:flex; justify-content:space-between; }
            .bullet::before { content:'\2022'; margin-right:4px; }
          </style>

          <!-- 抬头信息 -->
          <div class="center">
            <div class="bold" t-esc="company.display_name"/>
            <div class="xs">电话：<t t-esc="company.phone or ''"/></div>
            <div class="xs" t-if="company.receipt_business_number">营业编号：<t t-esc="company.receipt_business_number"/></div>
            <div class="xs" t-if="company.partner_id and company.partner_id.contact_address">地址：<t t-esc="company.partner_id.contact_address"/></div>
          </div>

          <t t-if="company.receipt_promo_lines">
            <div class="line"></div>
            <t t-foreach="(company.receipt_promo_lines or '').split('\n')" t-as="pline">
              <div class="center bold"><t t-esc="pline"/></div>
            </t>
          </t>

          <t t-if="company.receipt_slogan">
            <div class="line"></div>
            <div class="center bold"><t t-esc="company.receipt_slogan"/></div>
          </t>

          <div class="line"></div>

          <!-- 单据信息 -->
          <div>
            <div>日期：
              <t t-if="doc.date_order">
                <t t-esc="doc.date_order.strftime('%Y年%m月%d日')"/>
                （<t t-esc="['星期一','星期二','星期三','星期四','星期五','星期六','星期日'][doc.date_order.weekday()]"/>）
                <t t-esc="doc.date_order.strftime('%H:%M')"/>
              </t>
            </div>
            <div>编号：<t t-esc="doc.name"/></div>
            <div>收据号：（）</div>
            <div>传票号：（）</div>
            <div>负责人：<t t-esc="doc.user_id and doc.user_id.name or ''"/></div>
          </div>

          <div class="line"></div>

          <!-- 商品明细 -->
          <div class="mb4">商品明细</div>
          <t t-foreach="doc.order_line" t-as="l">
            <div class="list-row">
              <div class="l bullet">
                <t t-esc="l.product_id.display_name"/> ×<t t-esc="l.product_uom_qty"/>件
              </div>
              <div class="r" t-esc="l.price_subtotal" t-options="{'widget':'monetary','display_currency': doc.currency_id}"/>
            </div>
          </t>

          <div class="line"></div>

          <!-- 合计 -->
          <t t-set="total_qty" t-value="sum([l.product_uom_qty for l in doc.order_line])"/>
          <div class="list-row bold">
            <div class="l">合计（TOTAL）：<t t-esc="int(total_qty) if total_qty == int(total_qty) else total_qty"/>件</div>
            <div class="r" t-esc="doc.amount_total" t-options="{'widget':'monetary','display_currency': doc.currency_id}"/>
          </div>
          <div class="xs muted">（含消费税TAX 10%）</div>

          <!-- 付款信息（如可用） -->
          <t t-if="doc.invoice_ids">
            <div class="line"></div>
            <div class="mb4">付款</div>
            <t t-set="paid" t-value="sum([inv.amount_total - inv.amount_residual for inv in doc.invoice_ids if inv.state in ('posted','paid')])"/>
            <t t-if="paid">
              <div class="list-row">
                <div class="l bullet">已收：</div>
                <div class="r" t-esc="paid" t-options="{'widget':'monetary','display_currency': doc.currency_id}"/>
              </div>
              <t t-set="change" t-value="paid - doc.amount_total"/>
              <t t-if="change &gt; 0">
                <div class="list-row">
                  <div class="l bullet">找零：</div>
                  <div class="r" t-esc="change" t-options="{'widget':'monetary','display_currency': doc.currency_id}"/>
                </div>
              </t>
            </t>
          </t>

          <div class="line"></div>

          <!-- 备注与底部信息/条码 -->
          <div class="xs muted no-break">
            <t t-if="doc.note">备注：<t t-esc="doc.note"/><br/></t>
            <t t-if="company.receipt_show_barcode">
              <div class="center" style="margin-top:4px;">
                <img t-att-src="'/report/barcode/Code128/%s?width=300&amp;height=60&amp;humanreadable=1' % (doc.name or '')" alt="条码"/>
              </div>
            </t>
            <t t-if="company.receipt_show_qr">
              <div class="center" style="margin-top:4px;">
                <img t-att-src="'/report/barcode/QR/%s?width=150&amp;height=150' % (doc.name or '')" alt="二维码"/>
              </div>
            </t>
            <t t-if="company.receipt_footer_note">
              <div class="center"><t t-esc="company.receipt_footer_note"/></div>
            </t>
            <t t-else=""><div class="center">谢谢惠顾！</div></t>
          </div>
        </div>
      </t>
    </t>
  </template>

  <!-- 80mm 模板：固定 80mm 宽度（可用于独立动作） -->
  <template id="report_sale_receipt_document_80mm">
    <t t-call="web.basic_layout">
      <t t-foreach="docs" t-as="doc">
        <div class="page o_sale_receipt" style="width:80mm;">
          <t t-call="sale_receipt_thermal.report_sale_receipt_document">
            <t t-set="doc" t-value="doc"/>
          </t>
        </div>
      </t>
    </t>
  </template>

  <!-- ④ 报表动作：PDF 与 HTML 预览各一份（挂在“打印”菜单） -->
  <record id="action_report_sale_receipt_58mm_pdf" model="ir.actions.report">
    <field name="name">销售小票（58mm PDF）</field>
    <field name="model">sale.order</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">sale_receipt_thermal.report_sale_receipt_document</field>
    <field name="print_report_name">'Receipt-%s.pdf' % (object.name)</field>
    <field name="paperformat_id" ref="sale_receipt_thermal.paperformat_58mm_receipt"/>
    <field name="binding_model_id" ref="sale.model_sale_order"/>
    <field name="binding_type">report</field>
  </record>

  <record id="action_report_sale_receipt_58mm_html" model="ir.actions.report">
    <field name="name">销售小票（预览HTML 58mm）</field>
    <field name="model">sale.order</field>
    <field name="report_type">qweb-html</field>
    <field name="report_name">sale_receipt_thermal.report_sale_receipt_document</field>
    <field name="paperformat_id" ref="sale_receipt_thermal.paperformat_58mm_receipt"/>
    <field name="binding_model_id" ref="sale.model_sale_order"/>
    <field name="binding_type">report</field>
  </record>

  <!-- 80mm 动作（HTML/PDF） -->
  <record id="action_report_sale_receipt_80mm_pdf" model="ir.actions.report">
    <field name="name">销售小票（80mm PDF）</field>
    <field name="model">sale.order</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">sale_receipt_thermal.report_sale_receipt_document_80mm</field>
    <field name="print_report_name">'Receipt-%s.pdf' % (object.name)</field>
    <field name="paperformat_id" ref="sale_receipt_thermal.paperformat_80mm_receipt"/>
    <field name="binding_model_id" ref="sale.model_sale_order"/>
    <field name="binding_type">report</field>
  </record>

  <record id="action_report_sale_receipt_80mm_html" model="ir.actions.report">
    <field name="name">销售小票（预览HTML 80mm）</field>
    <field name="model">sale.order</field>
    <field name="report_type">qweb-html</field>
    <field name="report_name">sale_receipt_thermal.report_sale_receipt_document_80mm</field>
    <field name="paperformat_id" ref="sale_receipt_thermal.paperformat_80mm_receipt"/>
    <field name="binding_model_id" ref="sale.model_sale_order"/>
    <field name="binding_type">report</field>
  </record>

</odoo>
