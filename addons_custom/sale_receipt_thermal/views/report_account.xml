<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- 发票（account.move）热敏小票模板（58/80mm，复用公司配置） -->
  <template id="report_invoice_receipt_document">
    <t t-call="web.basic_layout">
      <t t-foreach="docs" t-as="doc">
        <div class="page o_invoice_receipt" t-attf-style="width:#{doc.company_id.receipt_paper_width or '58'}mm; font-size:#{doc.company_id.receipt_font_size or '10'}px;">
          <style>
            .o_invoice_receipt { font-family: "Noto Sans CJK SC","DejaVu Sans",sans-serif; line-height:1.25; color:#000; padding:2mm; margin:0 auto; }
            .center { text-align:center; } .bold{ font-weight:700;} .xs{font-size:8pt;} .muted{color:#333}
            .line{ border-top:1px dashed #000; margin:4px 0;} table{width:100%; border-collapse:collapse;} th,td{padding:2px 0; vertical-align:top;} .r{text-align:right}
          </style>
          <div class="center">
            <t t-if="doc.company_id.receipt_show_logo and doc.company_id.logo">
              <img t-att-src="'data:image/png;base64,%s' % (doc.company_id.logo)" style="max-height:40px;"/>
              <br/>
            </t>
            <div class="bold">发票小票</div>
            <div t-esc="doc.company_id and doc.company_id.display_name or ''"/>
            <div class="xs muted">
              <t t-esc="doc.company_id and doc.company_id.phone or ''"/> /
              <t t-esc="doc.company_id and doc.company_id.email or ''"/>
            </div>
          </div>
          <div class="line"></div>
          <table>
            <tr><td>发票号：</td><td class="r" t-esc="doc.name"/></tr>
            <tr><td>客户：</td><td class="r" t-esc="doc.partner_id.display_name"/></tr>
            <tr><td>开票日期：</td><td class="r" t-esc="doc.invoice_date and doc.invoice_date.strftime('%Y-%m-%d')"/></tr>
            <tr><td>到期日：</td><td class="r" t-esc="doc.invoice_date_due and doc.invoice_date_due.strftime('%Y-%m-%d')"/></tr>
            <tr><td>开票人：</td><td class="r" t-esc="doc.invoice_user_id and doc.invoice_user_id.name or ''"/></tr>
            <tr><td>付款条件：</td><td class="r" t-esc="doc.invoice_payment_term_id and doc.invoice_payment_term_id.name or ''"/></tr>
            <tr><td>状态：</td><td class="r" t-esc="doc.payment_state"/></tr>
          </table>
          <div class="line"></div>
          <table>
            <thead><tr><th>品名</th><th class="r">数量</th><th class="r">单价</th><th class="r">小计</th></tr></thead>
            <tbody>
              <tr t-foreach="doc.invoice_line_ids" t-as="l">
                <td>
                  <t t-esc="l.product_id and l.product_id.display_name or (l.name or '')"/>
                  <t t-if="l.name and l.product_id and l.name.strip() != l.product_id.display_name">
                    <br/><span class="xs muted" t-esc="l.name"/>
                  </t>
                </td>
                <td class="r" t-esc="l.quantity"/>
                <td class="r" t-esc="l.price_unit" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                <td class="r" t-esc="l.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
              </tr>
            </tbody>
          </table>
          <div class="line"></div>
          <table>
            <tr><td>未税：</td><td class="r" t-esc="doc.amount_untaxed" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></tr>
            <tr><td>税额：</td><td class="r" t-esc="doc.amount_tax" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></tr>
            <tr class="bold"><td>应收合计：</td><td class="r" t-esc="doc.amount_total" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></tr>
            <tr t-if="doc.payment_state in ('in_payment','paid')"><td>已收：</td><td class="r" t-esc="doc.amount_total - doc.amount_residual" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></tr>
            <tr><td>未收：</td><td class="r" t-esc="doc.amount_residual" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></tr>
          </table>
          <div class="line"></div>
          <div class="xs muted">
            <t t-if="doc.company_id.receipt_show_barcode">
              <div class="center" style="margin-top:4px;">
                <img t-att-src="'/report/barcode/Code128/%s?width=300&amp;height=60&amp;humanreadable=1' % (doc.name or '')" alt="条码"/>
              </div>
            </t>
            <t t-if="doc.company_id.receipt_show_qr">
              <div class="center" style="margin-top:4px;">
                <img t-att-src="'/report/barcode/QR/%s?width=150&amp;height=150' % (doc.name or '')" alt="二维码"/>
              </div>
            </t>
            <t t-if="doc.company_id.receipt_footer_note">
              <div class="center"><t t-esc="doc.company_id.receipt_footer_note"/></div>
            </t>
            <t t-else="">
              <div class="center">谢谢惠顾！</div>
            </t>
          </div>
        </div>
      </t>
    </t>
  </template>

  <!-- 绑定到 account.move 的报表动作（HTML+PDF / 58mm+80mm） -->
  <record id="action_report_invoice_receipt_58mm_pdf" model="ir.actions.report">
    <field name="name">发票小票（58mm PDF）</field>
    <field name="model">account.move</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">sale_receipt_thermal.report_invoice_receipt_document</field>
    <field name="paperformat_id" ref="sale_receipt_thermal.paperformat_58mm_receipt"/>
    <field name="binding_model_id" ref="account.model_account_move"/>
    <field name="binding_type">report</field>
  </record>
  <record id="action_report_invoice_receipt_58mm_html" model="ir.actions.report">
    <field name="name">发票小票（预览HTML 58mm）</field>
    <field name="model">account.move</field>
    <field name="report_type">qweb-html</field>
    <field name="report_name">sale_receipt_thermal.report_invoice_receipt_document</field>
    <field name="paperformat_id" ref="sale_receipt_thermal.paperformat_58mm_receipt"/>
    <field name="binding_model_id" ref="account.model_account_move"/>
    <field name="binding_type">report</field>
  </record>
  <record id="action_report_invoice_receipt_80mm_pdf" model="ir.actions.report">
    <field name="name">发票小票（80mm PDF）</field>
    <field name="model">account.move</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">sale_receipt_thermal.report_invoice_receipt_document</field>
    <field name="paperformat_id" ref="sale_receipt_thermal.paperformat_80mm_receipt"/>
    <field name="binding_model_id" ref="account.model_account_move"/>
    <field name="binding_type">report</field>
  </record>
  <record id="action_report_invoice_receipt_80mm_html" model="ir.actions.report">
    <field name="name">发票小票（预览HTML 80mm）</field>
    <field name="model">account.move</field>
    <field name="report_type">qweb-html</field>
    <field name="report_name">sale_receipt_thermal.report_invoice_receipt_document</field>
    <field name="paperformat_id" ref="sale_receipt_thermal.paperformat_80mm_receipt"/>
    <field name="binding_model_id" ref="account.model_account_move"/>
    <field name="binding_type">report</field>
  </record>

</odoo>
